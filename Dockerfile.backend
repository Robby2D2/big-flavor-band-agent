# syntax=docker/dockerfile:1
# Backend Dockerfile - Python FastAPI Service
FROM python:3.12-slim as base

# Install system dependencies. gosu lets the entrypoint start as root (to
# chown bind-mounted volumes — see docker-entrypoint-backend.sh) and then
# drop to appuser without the signal-handling quirks of `su`.
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsndfile1 \
    gosu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Heavy ML stack (torch/transformers/demucs) in its own layer, copied and
# installed first so it only reinstalls when requirements-ml.txt itself
# changes — not on every unrelated requirements-api.txt edit. This container
# shares the host GPU with bigflavor-ollama (see docker-compose.yml), so we
# keep PyPI's default CUDA-enabled torch/torchaudio wheels here (do not add
# a CPU-only --extra-index-url — that silently strips GPU support). The pip
# cache mount lets BuildKit reuse downloaded wheels across builds instead of
# re-fetching them every time.
COPY requirements-ml.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-ml.txt

# faster-whisper's backend (ctranslate2) is a precompiled wheel that dlopens
# CUDA 12's cuBLAS/cuDNN by name at runtime, independent of whatever CUDA
# version torch itself resolved to (nvidia-cublas-cu12/nvidia-cudnn-cu12 in
# requirements-ml.txt install those cu12-named .so files, but pip drops them
# in site-packages without registering them with ldconfig). Without this on
# LD_LIBRARY_PATH, GPU transcription fails at runtime with "Library
# libcublas.so.12 is not found or cannot be loaded" even though
# torch.cuda.is_available() is True.
ENV LD_LIBRARY_PATH="/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib"

# Copy remaining (lighter, more frequently changed) requirements
COPY requirements-api.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-api.txt

# Copy application code
COPY backend_api.py .
COPY src/ ./src/
COPY database/ ./database/

# Create directory for audio library (will be mounted as volume)
RUN mkdir -p /app/audio_library

# Run as a non-root user. Own the app dir (including the audio_library mount point)
# so the process can read mounted volumes and write the shared playlist directory.
# Stays root at container start (no USER here) — the entrypoint below needs
# root to chown bind-mounted volumes before dropping to appuser itself.
RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app

COPY docker-entrypoint-backend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

# Expose port 8000
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# Run the application
CMD ["python", "-m", "uvicorn", "backend_api:app", "--host", "0.0.0.0", "--port", "8000"]
